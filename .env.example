# Cadena de conexión de Neon Postgres (pooled o directa, ambas con sslmode).
DATABASE_URL='postgresql://user:password@host/db?sslmode=require'

# next-auth: generar con `openssl rand -base64 32`.
AUTH_SECRET=''
# NO definir AUTH_URL: con `trustHost` next-auth la deduce de la petición.
# Ojo: si `neon.ts` tiene `auth: true`, `neon env pull` / `neon deploy` escriben
# AUTH_URL y AUTH_SECRET de Neon Auth (Better Auth) en .env; AUTH_URL rompe el
# login de next-auth (cookie y redirección a otro host). Bórrala tras cada pull.

# Nombre público de la tienda (header, título, footer).
NEXT_PUBLIC_STORE_NAME='Buchito'

# Fotos de producto: bucket `products` de Neon Object Storage. Estas cuatro las
# escribe `neon env pull` (o `neon deploy`) al tener buckets en neon.ts.
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_ENDPOINT_URL_S3='https://<branch>.storage.<region>.aws.neon.tech'
AWS_REGION='us-east-2'

# CDN delante de las fotos (opcional). Sin esto la app las sirve por
# `/media/<clave>` con caché inmutable, que el edge de Vercel (o el CDN que
# tengas delante de la app) ya cachea. Si montas un CDN propio con origen
# `${AWS_ENDPOINT_URL_S3}/products/`, pon aquí su URL pública, sin barra final:
# NEXT_PUBLIC_IMAGE_CDN_URL='https://img.tu-dominio.com'

# Usuario admin que crea `pnpm db:seed` (también crea un mensajero y un
# cliente de prueba con la misma contraseña).
SEED_ADMIN_EMAIL='admin@buchito.local'
SEED_ADMIN_PASSWORD='cambiar-en-local'
