{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "buchito-store",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "dev",
        "--turbopack"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "buchito-store-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
